# AskTHIH HVAC Staging Environment Variables
#
# This is a template file showing the required variables for staging deployment.
# DO NOT commit real credentials to this file.
# DO NOT commit .env files at all.
#
# To use:
# 1. Copy this file to .env.askthih-hvac-staging (in secure location, not in repo)
# 2. Fill in real values (obtained from secure credentials manager)
# 3. Load variables before running webhook server:
#    export $(cat .env.askthih-hvac-staging | xargs)
#    or in PowerShell:
#    Get-Content .env.askthih-hvac-staging | ForEach-Object { $key, $value = $_.split('='); [System.Environment]::SetEnvironmentVariable($key, $value) }

# SowerBase API Endpoint (HTTPS required for staging/production)
SOWERBASE_BASE_URL=https://[STAGING-SOWERBASE-API-URL]

# NocoDB API Token (NEVER hard-code or print)
# Obtain from production NocoDB admin panel
SOWERBASE_API_TOKEN=[REDACTED]

# Intake Submissions Table ID (NEVER hard-code or print)
# Discover via: GET https://[SOWERBASE_BASE_URL]/api/v2/db/meta/tables
SOWERBASE_INTAKE_TABLE_ID=[REDACTED]

# Webhook Server Port (default: 8787, change if needed)
ASKTHIH_WEBHOOK_PORT=8787

# Webhook Signature Secret (NEVER hard-code or print)
# Generate: openssl rand -hex 32
ASKTHIH_WEBHOOK_SECRET=[REDACTED]

# CORS Allowed Origins (staging only)
ALLOWED_ORIGINS=https://askthih.com,https://www.askthih.com

# Optional: Rate Limiting Configuration
# Max requests per second per IP
# ASKTHIH_WEBHOOK_RATE_LIMIT=10

# Optional: Request Size Limit (bytes)
# ASKTHIH_WEBHOOK_MAX_SIZE=10240

# Optional: Timestamp Validation Window (seconds)
# ASKTHIH_WEBHOOK_TIMESTAMP_WINDOW=300`n`n# HVAC operational routing
# Default live mode: write to SowerBase first.
ASKTHIH_HVAC_INTAKE_PRIMARY=sowerbase

# Airtable handling for the HVAC path: fallback, shadow, or off.
ASKTHIH_HVAC_AIRTABLE_MODE=fallback

# One-switch rollback. Set to airtable to route HVAC intake back to Airtable primary.
# ASKTHIH_HVAC_ROLLBACK_PRIMARY=airtable

# Airtable fallback/shadow credentials (NEVER hard-code or print real tokens)
AIRTABLE_BASE_ID=app60wQWdbbgyqTcL
AIRTABLE_HVAC_TABLE_NAME=HVAC Intake
AIRTABLE_API_TOKEN=[REDACTED]
